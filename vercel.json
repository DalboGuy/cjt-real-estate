{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/booking-v2.html"
    },
    {
      "source": "/book",
      "destination": "/booking-v2.html"
    },
    {
      "source": "/complete-booking",
      "destination": "/complete-booking.html"
    },
    {
      "source": "/owner-v1/calendar",
      "destination": "/owner-v1/calendar.html"
    },
    {
      "source": "/owner-v1/financials",
      "destination": "/under-construction.html"
    },
    {
      "source": "/owner-v1/property",
      "destination": "/under-construction.html"
    },
    {
      "source": "/owner-v1/maintenance",
      "destination": "/under-construction.html"
    },
    {
      "source": "/owner-v1/analytics",
      "destination": "/under-construction.html"
    },
    {
      "source": "/owner-v1/settings",
      "destination": "/under-construction.html"
    },
    {
      "source": "/admin-v1/properties",
      "destination": "/under-construction.html"
    },
    {
      "source": "/admin-v1/roles",
      "destination": "/under-construction.html"
    },
    {
      "source": "/admin-v1/integrations",
      "destination": "/under-construction.html"
    },
    {
      "source": "/admin-v1/notifications",
      "destination": "/under-construction.html"
    },
    {
      "source": "/admin-v1/system-data",
      "destination": "/under-construction.html"
    },
    {
      "source": "/account-v1/notifications",
      "destination": "/under-construction.html"
    },
    {
      "source": "/account-v1/property-access",
      "destination": "/under-construction.html"
    },
    {
      "source": "/direct-bookings.ics",
      "destination": "/api/direct-bookings"
    },
    {
      "source": "/bookingcom.ics",
      "destination": "/api/direct-bookings?bookingcom=1"
    }
  ],
  "functions": {
    "api/calendar.js": {
      "maxDuration": 10
    },
    "api/direct-bookings.js": {
      "maxDuration": 10
    },
    "api/inquiries.js": {
      "maxDuration": 10
    },
    "api/complete-booking.js": {
      "maxDuration": 10
    },
    "api/owner.js": {
      "maxDuration": 10
    },
    "api/pricing.js": {
      "maxDuration": 10
    }
  }
}
